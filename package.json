{
  "name": "calmpal-crossplatform",
  "version": "4.6.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.23",
    "expo-audio": "~57.0.5",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.1",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.4.12",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:ios": "rm -rf build ios/assets && mkdir -p build ios/assets && npx expo export:embed --entry-file index.ts --platform ios --dev false --bundle-output build/bundle.js --assets-dest build/assets && ios/Pods/hermes-engine/destroot/bin/hermesc -emit-binary -max-diagnostic-width=80 -O -out ios/main.jsbundle build/bundle.js && cp -R build/assets/* ios/assets/",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "private": true
}
