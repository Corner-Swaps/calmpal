{
  "name": "calmpal-crossplatform",
  "version": "5.6.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.14",
    "expo-audio": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.4.15",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:ios": "rm -rf build ios/assets && mkdir -p build && npx expo export:embed --entry-file index.ts --platform ios --dev false --bundle-output build/bundle.js --assets-dest build && ios/Pods/hermes-engine/destroot/bin/hermesc -emit-binary -max-diagnostic-width=80 -O -out ios/main.jsbundle build/bundle.js && cp -R build/assets ios/assets",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "private": true
}
